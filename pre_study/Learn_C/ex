#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct inf {
    char *name;
    double high;
    double weight;
} Inf;

int main()
{
    Inf *a = malloc(sizeof(Inf));
    a->name = malloc(128);
    a->high = 100.23;
    a->weight = 323.32;
    char *h = "fuck you shift";
    strncpy(a->name, h, 14);
    *(a->name+14) = '\0';
    printf("%p\n",a->name);
    printf("%s",a->name);
    FILE *fl=fopen("test.txt","w"); //上一个程序是w+b 以这种方式读出依旧是乱码因为w模式不允许读
    fwrite(a,sizeof(Inf),1,fl);
    fwrite(a->name,128,1,fl);
    fclose(fl);
    free(a->name);
    free(a);
    
    Inf *b = malloc(sizeof(Inf));
    b->name = malloc(128);
    fl=fopen("test.txt","r"); //上一个程序是w+b 以这种方式读出依旧是乱码因为w模式不允许读
    fread(b,sizeof(Inf),1,fl);
    fread(b->name,128,1,fl);
    *(b->name+14) = '\0';
    printf("%p\n",b->name);
    printf("%s",b->name);
    fclose(fl);
    free(b->name);
    free(b);
return 0;
}